rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email_verified == true &&
          (
            request.auth.token.email == 'faoj2013@gmail.com' ||
            request.auth.token.email == 'andrezmelo13@gmail.com'
          )
        )
      );
    }

    function isValidVipTipo(t) {
      return t == 'fundador' || t == 'estandar' || t == 'rastreo_cepos' || t == 'vip_m34';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveVip() {
      return hasUserDoc()
        && 'vipActivo' in userData()
        && userData().vipActivo == true
        && 'vipTipo' in userData()
        && (
          userData().vipTipo == 'fundador' ||
          (
            (userData().vipTipo == 'estandar' || userData().vipTipo == 'rastreo_cepos' || userData().vipTipo == 'vip_m34') &&
            'vipExpiraAt' in userData() &&
            userData().vipExpiraAt is timestamp &&
            userData().vipExpiraAt > request.time
          )
        );
    }

    function isVipM34OrAdmin() {
      return isAdmin() || (isActiveVip() && userData().vipTipo == 'vip_m34');
    }

    function isValidReporte(data) {
      return data.keys().hasAll([
          'lat', 'lng', 'tipo', 'descripcion', 'isFixed',
          'timestamp', 'confirmations', 'denials', 'authorId'
        ])
        && data.keys().hasOnly([
          'lat', 'lng', 'tipo', 'descripcion', 'isFixed',
          'timestamp', 'urlFoto', 'mediaType', 'confirmations', 'denials', 'authorId',
          'confirmaciones', 'confirmadoPor', 'expiresAt',
          'puntoReaccionId', 'puntoReaccionNombre', 'activacionRapida', 'radioMetros', 'vipNivel'
        ])
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.tipo is string && data.tipo.size() >= 2 && data.tipo.size() <= 40
        && data.descripcion is string && data.descripcion.size() <= 400
        && data.isFixed is bool
        && data.timestamp is timestamp
        && data.confirmations is int && data.confirmations >= 0
        && data.denials is int && data.denials >= 0
        && data.authorId is string && isValidId(data.authorId)
        && (!('urlFoto' in data) || data.urlFoto == null || (data.urlFoto is string && data.urlFoto.size() <= 450000))
        && (!('mediaType' in data) || data.mediaType == null || data.mediaType == 'image' || data.mediaType == 'video')
        && (!('confirmaciones' in data) || (data.confirmaciones is int && data.confirmaciones >= 1))
        && (!('confirmadoPor' in data) || (
          data.confirmadoPor is list
          && data.confirmadoPor.size() >= 1
          && data.confirmadoPor.size() <= 50
          && data.confirmadoPor[0] is string
          && data.confirmadoPor[0].size() <= 128
        ))
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && (!('puntoReaccionId' in data) || data.puntoReaccionId == null || (data.puntoReaccionId is string && isValidId(data.puntoReaccionId)))
        && (!('puntoReaccionNombre' in data) || data.puntoReaccionNombre == null || (data.puntoReaccionNombre is string && data.puntoReaccionNombre.size() <= 80))
        && (!('activacionRapida' in data) || (
          data.activacionRapida == 'normal' ||
          data.activacionRapida == 'foto' ||
          data.activacionRapida == 'punto_reaccion' ||
          data.activacionRapida == 'admin' ||
          data.activacionRapida == 'vip_fundador' ||
          data.activacionRapida == 'vip_estandar' ||
          data.activacionRapida == 'vip_cepos' ||
          data.activacionRapida == 'vip_m34'
        ))
        && (!('radioMetros' in data) || data.radioMetros == null || (data.radioMetros is int && data.radioMetros >= 50 && data.radioMetros <= 100))
        && (!('vipNivel' in data) || data.vipNivel == null || isValidVipTipo(data.vipNivel));
    }

    function hasAttachedPhoto(data) {
      return 'urlFoto' in data && data.urlFoto is string && data.urlFoto.size() > 100 && data.urlFoto.size() <= 450000;
    }

    function hasValidReactionPoint(data) {
      return 'puntoReaccionId' in data
        && data.puntoReaccionId is string
        && isValidId(data.puntoReaccionId)
        && (
          exists(/databases/$(database)/documents/puntos_reaccion_inmediata/$(data.puntoReaccionId)) ||
          exists(/databases/$(database)/documents/puntos_reaccion/$(data.puntoReaccionId))
        );
    }

    function isValidPuntoReaccion(data) {
      return data.keys().hasAll(['nombre', 'lat', 'lng', 'radioMetros', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['nombre', 'lat', 'lng', 'radioMetros', 'createdBy', 'createdAt'])
        && data.nombre is string && data.nombre.size() >= 2 && data.nombre.size() <= 60
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.radioMetros is int && data.radioMetros >= 50 && data.radioMetros <= 2000
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidCodigoVip(data) {
      return data.keys().hasAll(['codigo', 'tipoVip', 'activo', 'maxUsos', 'usosActuales', 'expiraAt', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['codigo', 'tipoVip', 'activo', 'maxUsos', 'usosActuales', 'expiraAt', 'nota', 'createdBy', 'createdAt'])
        && data.codigo is string && data.codigo.size() >= 4 && data.codigo.size() <= 32 && data.codigo.matches('^[A-Z0-9_\\-]+$')
        && isValidVipTipo(data.tipoVip)
        && data.activo is bool
        && data.maxUsos is int && data.maxUsos >= 1 && data.maxUsos <= 500
        && data.usosActuales is int && data.usosActuales >= 0 && data.usosActuales <= data.maxUsos
        && (
          (data.tipoVip == 'fundador' && data.expiraAt == null) ||
          ((data.tipoVip == 'estandar' || data.tipoVip == 'rastreo_cepos' || data.tipoVip == 'vip_m34') && data.expiraAt is timestamp)
        )
        && (!('nota' in data) || (data.nota is string && data.nota.size() <= 120))
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidCanjeVip(data) {
      return data.keys().hasAll(['uid', 'usuario', 'codigo', 'tipoVip', 'canjeadoAt'])
        && data.keys().hasOnly(['uid', 'usuario', 'codigo', 'tipoVip', 'canjeadoAt'])
        && data.uid is string && isValidId(data.uid)
        && data.usuario is string && data.usuario.size() >= 1 && data.usuario.size() <= 200
        && data.codigo is string && data.codigo.size() >= 4 && data.codigo.size() <= 32 && data.codigo.matches('^[A-Z0-9_\\-]+$')
        && isValidVipTipo(data.tipoVip)
        && data.canjeadoAt is timestamp;
    }

    function isValidReporteEliminado(data) {
      return data.keys().hasAll([
          'reportId', 'tipo', 'descripcion', 'lat', 'lng', 'authorId',
          'eliminadoPorUid', 'eliminadoPorUsuario', 'eliminadoPorRol', 'eliminadoAt'
        ])
        && data.keys().hasOnly([
          'reportId', 'tipo', 'descripcion', 'lat', 'lng', 'authorId',
          'eliminadoPorUid', 'eliminadoPorUsuario', 'eliminadoPorRol', 'eliminadoAt'
        ])
        && data.reportId is string && isValidId(data.reportId)
        && data.tipo is string && data.tipo.size() >= 2 && data.tipo.size() <= 40
        && data.descripcion is string && data.descripcion.size() <= 400
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.authorId is string && isValidId(data.authorId)
        && data.eliminadoPorUid is string && isValidId(data.eliminadoPorUid)
        && data.eliminadoPorUsuario is string && data.eliminadoPorUsuario.size() >= 1 && data.eliminadoPorUsuario.size() <= 200
        && (
          data.eliminadoPorRol == 'admin' ||
          data.eliminadoPorRol == 'vip_fundador' ||
          data.eliminadoPorRol == 'vip_estandar' ||
          data.eliminadoPorRol == 'vip_cepos' ||
          data.eliminadoPorRol == 'vip_m34' ||
          data.eliminadoPorRol == 'autor'
        )
        && data.eliminadoAt is timestamp;
    }

    function isValidVoto(data) {
      return data.keys().hasAll(['voteType', 'userId', 'createdAt'])
        && data.keys().hasOnly(['voteType', 'userId', 'createdAt'])
        && (data.voteType == 'confirm' || data.voteType == 'deny')
        && data.userId is string && isValidId(data.userId)
        && data.createdAt is timestamp;
    }

    function isValidSugerencia(data) {
      return data.keys().hasAll(['mensaje', 'usuario', 'authorId', 'timestamp'])
        && data.keys().hasOnly(['mensaje', 'usuario', 'authorId', 'timestamp', 'leido'])
        && data.mensaje is string && data.mensaje.size() >= 3 && data.mensaje.size() <= 1000
        && data.usuario is string && data.usuario.size() >= 3 && data.usuario.size() <= 200
        && data.authorId is string && isValidId(data.authorId)
        && data.timestamp is timestamp
        && (!('leido' in data) || data.leido is bool);
    }

    function isValidSugerenciaBuzonV2(data) {
      return data.keys().hasAll(['mensaje', 'usuario', 'uid', 'fecha', 'leido'])
        && data.keys().hasOnly(['mensaje', 'usuario', 'uid', 'fecha', 'leido'])
        && data.mensaje is string && data.mensaje.size() >= 3 && data.mensaje.size() <= 1000
        && data.usuario is string && data.usuario.size() >= 3 && data.usuario.size() <= 200
        && data.uid is string && isValidId(data.uid)
        && data.fecha is timestamp
        && data.leido is bool;
    }

    function isValidUserDoc(data) {
      return data.keys().hasAll(['activeSessionId', 'lastLoginAt'])
        && data.keys().hasOnly([
          'activeSessionId', 'lastLoginAt',
          'vipTipo', 'vipActivo', 'vipCodigo', 'vipExpiraAt', 'vipActivadoAt'
        ])
        && data.activeSessionId is string
        && data.activeSessionId.size() >= 8
        && data.activeSessionId.size() <= 128
        && data.activeSessionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.lastLoginAt is timestamp
        && (!('vipTipo' in data) || isValidVipTipo(data.vipTipo))
        && (!('vipActivo' in data) || data.vipActivo is bool)
        && (!('vipCodigo' in data) || (data.vipCodigo is string && data.vipCodigo.size() >= 4 && data.vipCodigo.size() <= 32 && data.vipCodigo.matches('^[A-Z0-9_\\-]+$')))
        && (!('vipExpiraAt' in data) || data.vipExpiraAt == null || data.vipExpiraAt is timestamp)
        && (!('vipActivadoAt' in data) || data.vipActivadoAt is timestamp);
    }

    function isValidHojaVida(data) {
      return data.keys().hasAll([
          'tipoVehiculo', 'placa',
          'soatVencimiento', 'tecnoVencimiento',
          'tarjetaOperacionVencimiento', 'pazSalvoVencimiento',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'tipoVehiculo', 'placa', 'kmActual',
          'soatVencimiento', 'tecnoVencimiento',
          'paseVencimiento', 'tarjetaOperacionVencimiento', 'pazSalvoVencimiento',
          'recordatorios', 'updatedAt'
        ])
        && (data.tipoVehiculo == 'particular' || data.tipoVehiculo == 'moto' || data.tipoVehiculo == 'taxi' || data.tipoVehiculo == 'camioneta')
        && data.placa is string && data.placa.size() <= 10 && (data.placa == '' || data.placa.matches('^[A-Z]{3}[0-9]{3}$'))
        && data.soatVencimiento is string && data.soatVencimiento.size() <= 20
        && data.tecnoVencimiento is string && data.tecnoVencimiento.size() <= 20
        && data.tarjetaOperacionVencimiento is string && data.tarjetaOperacionVencimiento.size() <= 20
        && data.pazSalvoVencimiento is string && data.pazSalvoVencimiento.size() <= 20
        && (!('kmActual' in data) || (data.kmActual is number && data.kmActual >= 0 && data.kmActual <= 5000000))
        && (!('paseVencimiento' in data) || (data.paseVencimiento is string && data.paseVencimiento.size() <= 20))
        && (!('recordatorios' in data) || (data.recordatorios is list && data.recordatorios.size() <= 25 && (data.recordatorios.size() == 0 || data.recordatorios[0] is map)))
        && data.updatedAt is timestamp;
    }

    function isValidCierreEvento(data) {
      return data.keys().hasAll([
          'titulo', 'sector', 'mensaje', 'cierreModo', 'cierrePuntos',
          'evacuacionRutas', 'centerLat', 'centerLng', 'startsAtMs', 'endsAtMs',
          'activo', 'sinSonar', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'titulo', 'sector', 'mensaje', 'cierreModo', 'cierrePuntos',
          'evacuacionRutas', 'centerLat', 'centerLng', 'startsAtMs', 'endsAtMs',
          'activo', 'sinSonar', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.titulo is string && data.titulo.size() >= 2 && data.titulo.size() <= 80
        && data.sector is string && data.sector.size() <= 120
        && data.mensaje is string && data.mensaje.size() <= 320
        && (data.cierreModo == 'tramo' || data.cierreModo == 'cuadrante')
        && data.cierrePuntos is list
        && data.cierrePuntos.size() >= 2
        && data.cierrePuntos.size() <= 80
        && data.cierrePuntos[0] is map
        && data.evacuacionRutas is list
        && data.evacuacionRutas.size() <= 8
        && (data.evacuacionRutas.size() == 0 || data.evacuacionRutas[0] is map)
        && data.centerLat is number && data.centerLat >= -90 && data.centerLat <= 90
        && data.centerLng is number && data.centerLng >= -180 && data.centerLng <= 180
        && data.startsAtMs is int && data.startsAtMs > 0
        && data.endsAtMs is int && data.endsAtMs > data.startsAtMs
        && data.activo is bool
        && data.sinSonar == true
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTipoVehiculo(v) {
      return v == 'taxi' || v == 'particular' || v == 'moto' || v == 'camioneta';
    }

    function isValidEmergenciaM34(data) {
      return data.keys().hasAll([
          'estado', 'authorId', 'apodo', 'tipoVehiculo', 'lat', 'lng',
          'sector', 'nota', 'fotoCierre', 'finalizadoPorUid',
          'finalizadoPorApodo', 'finalizadoAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'estado', 'authorId', 'apodo', 'tipoVehiculo', 'lat', 'lng',
          'sector', 'nota', 'fotoCierre', 'finalizadoPorUid',
          'finalizadoPorApodo', 'finalizadoAt', 'createdAt', 'updatedAt'
        ])
        && (data.estado == 'ACTIVA' || data.estado == 'FINALIZADA')
        && data.authorId is string && isValidId(data.authorId)
        && data.apodo is string && data.apodo.size() >= 1 && data.apodo.size() <= 32
        && data.tipoVehiculo is string && isValidTipoVehiculo(data.tipoVehiculo)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.sector is string && data.sector.size() <= 160
        && data.nota is string && data.nota.size() <= 240
        && (data.fotoCierre == null || (data.fotoCierre is string && data.fotoCierre.size() <= 450000))
        && (data.finalizadoPorUid == null || (data.finalizadoPorUid is string && isValidId(data.finalizadoPorUid)))
        && (data.finalizadoPorApodo == null || (data.finalizadoPorApodo is string && data.finalizadoPorApodo.size() <= 32))
        && (data.finalizadoAt == null || data.finalizadoAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApoyoM34(data) {
      return data.keys().hasAll([
          'uid', 'apodo', 'tipoVehiculo', 'lat', 'lng', 'sector',
          'estadoApoyo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'apodo', 'tipoVehiculo', 'lat', 'lng', 'sector',
          'estadoApoyo', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && isValidId(data.uid)
        && data.apodo is string && data.apodo.size() >= 1 && data.apodo.size() <= 32
        && data.tipoVehiculo is string && isValidTipoVehiculo(data.tipoVehiculo)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.sector is string && data.sector.size() <= 160
        && (data.estadoApoyo == 'EN_CAMINO' || data.estadoApoyo == 'EN_SITIO')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /reportes/{reportId} {
      // Road alerts contain zero PII and are public for drivers viewing the map (bounded to <= 200 docs per query)
      allow get: if isValidId(reportId);
      allow list: if request.query.limit != null && request.query.limit <= 200;

      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReporte(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().timestamp == request.time
        && incoming().denials == 0
        && (
          (incoming().confirmations == 1 && (!('confirmaciones' in incoming()) || incoming().confirmaciones == 1)) ||
          (
            incoming().confirmations == 3
            && 'confirmaciones' in incoming()
            && incoming().confirmaciones == 3
            && (isAdmin() || hasAttachedPhoto(incoming()) || hasValidReactionPoint(incoming()) || isActiveVip())
          )
        )
        && (!('vipNivel' in incoming()) || incoming().vipNivel == null || (isActiveVip() && userData().vipTipo == incoming().vipNivel))
        && (!('activacionRapida' in incoming()) || (
          incoming().activacionRapida == 'normal' ||
          incoming().activacionRapida == 'foto' ||
          incoming().activacionRapida == 'punto_reaccion' ||
          (incoming().activacionRapida == 'admin' && isAdmin()) ||
          (incoming().activacionRapida == 'vip_fundador' && isActiveVip() && userData().vipTipo == 'fundador') ||
          (incoming().activacionRapida == 'vip_estandar' && isActiveVip() && userData().vipTipo == 'estandar') ||
          (incoming().activacionRapida == 'vip_cepos' && isActiveVip() && userData().vipTipo == 'rastreo_cepos') ||
          (incoming().activacionRapida == 'vip_m34' && isActiveVip() && userData().vipTipo == 'vip_m34')
        ))
        && (!('confirmadoPor' in incoming()) || (
          incoming().confirmadoPor.size() == 1
          && incoming().confirmadoPor[0] == request.auth.uid
        ))
        && (!('expiresAt' in incoming()) || incoming().expiresAt <= request.time + duration.value(12, 'h'))
        && (incoming().tipo != 'Cierre Evento' || isAdmin())
        && (incoming().isFixed == false || isAdmin());

      allow update: if isSignedIn()
        && isValidId(reportId)
        && isValidReporte(incoming())
        && incoming().authorId == existing().authorId
        && incoming().timestamp == existing().timestamp
        && (
          (
            isAdmin()
            && !incoming().diff(existing()).affectedKeys().hasAny(['confirmations', 'denials', 'confirmaciones', 'confirmadoPor'])
          ) ||
          (
            incoming().lat == existing().lat
            && incoming().lng == existing().lng
            && incoming().diff(existing()).affectedKeys().hasOnly(['confirmations', 'confirmaciones', 'confirmadoPor', 'expiresAt'])
            && (
              incoming().confirmations == existing().confirmations + 1 ||
              (isActiveVip() && (incoming().confirmations == existing().confirmations + 2 || incoming().confirmations == existing().confirmations + 3))
            )
            && (!('confirmaciones' in incoming()) || incoming().confirmaciones == incoming().confirmations)
            && (!('confirmadoPor' in incoming()) || (
              (!('confirmadoPor' in existing()) && request.auth.uid in incoming().confirmadoPor && incoming().confirmadoPor.size() == 1) ||
              ('confirmadoPor' in existing() && !(request.auth.uid in existing().confirmadoPor) && request.auth.uid in incoming().confirmadoPor && incoming().confirmadoPor.size() == existing().confirmadoPor.size() + 1)
            ))
            && (!('expiresAt' in incoming()) || incoming().expiresAt <= request.time + duration.value(12, 'h'))
            && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
          ) ||
          (
            incoming().lat == existing().lat
            && incoming().lng == existing().lng
            && incoming().diff(existing()).affectedKeys().hasOnly(['denials'])
            && incoming().denials == existing().denials + 1
            && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
          ) ||
          (
            existing().authorId == request.auth.uid
            && incoming().lat == existing().lat
            && incoming().lng == existing().lng
            && incoming().isFixed == existing().isFixed
            && incoming().diff(existing()).affectedKeys().hasOnly(['tipo', 'descripcion', 'urlFoto', 'mediaType', 'radioMetros'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(reportId)
        && (
          isAdmin() ||
          existing().authorId == request.auth.uid ||
          (
            isActiveVip()
            && existing().isFixed == false
            && existsAfter(/databases/$(database)/documents/reportes_eliminados/$(reportId))
          )
        );

      match /votos/{userId} {
        allow get: if isSignedIn()
          && isValidId(reportId)
          && isValidId(userId)
          && request.auth.uid == userId;

        allow list, update, delete: if false;

        allow create: if isSignedIn()
          && isValidId(reportId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/reportes/$(reportId))
          && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(userId))
          && isValidVoto(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
      }
    }

    match /reportes_eliminados/{reportId} {
      allow get: if isAdmin() && isValidId(reportId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReporteEliminado(incoming())
        && incoming().reportId == reportId
        && incoming().eliminadoPorUid == request.auth.uid
        && incoming().eliminadoAt == request.time
        && exists(/databases/$(database)/documents/reportes/$(reportId))
        && !existsAfter(/databases/$(database)/documents/reportes/$(reportId))
        && (
          (isAdmin() && incoming().eliminadoPorRol == 'admin') ||
          (get(/databases/$(database)/documents/reportes/$(reportId)).data.authorId == request.auth.uid && incoming().eliminadoPorRol == 'autor') ||
          (
            isActiveVip()
            && get(/databases/$(database)/documents/reportes/$(reportId)).data.isFixed == false
            && (
              (incoming().eliminadoPorRol == 'vip_fundador' && userData().vipTipo == 'fundador') ||
              (incoming().eliminadoPorRol == 'vip_estandar' && userData().vipTipo == 'estandar') ||
              (incoming().eliminadoPorRol == 'vip_cepos' && userData().vipTipo == 'rastreo_cepos') ||
              (incoming().eliminadoPorRol == 'vip_m34' && userData().vipTipo == 'vip_m34')
            )
          )
        );
      allow update, delete: if false;
    }

    match /buzon/{sugerenciaId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(sugerenciaId)
        && isValidSugerencia(incoming())
        && incoming().timestamp == request.time
        && (!('leido' in incoming()) || incoming().leido == false)
        && (
          (request.auth == null && incoming().authorId == 'anonimo' && incoming().usuario == 'Anónimo') ||
          (isSignedIn() && incoming().authorId == request.auth.uid)
        );
      allow update: if isAdmin()
        && isValidId(sugerenciaId)
        && isValidSugerencia(incoming())
        && incoming().authorId == existing().authorId
        && incoming().timestamp == existing().timestamp
        && incoming().mensaje == existing().mensaje
        && incoming().usuario == existing().usuario
        && incoming().diff(existing()).affectedKeys().hasOnly(['leido'])
        && incoming().leido is bool;
      allow delete: if isAdmin() && isValidId(sugerenciaId);
    }

    match /buzon_sugerencias/{sugerenciaId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(sugerenciaId)
        && isValidSugerenciaBuzonV2(incoming())
        && incoming().fecha == request.time
        && incoming().leido == false
        && (
          (request.auth == null && incoming().uid == 'anonimo' && incoming().usuario == 'Anónimo') ||
          (isSignedIn() && incoming().uid == request.auth.uid)
        );
      allow update: if isAdmin()
        && isValidId(sugerenciaId)
        && isValidSugerenciaBuzonV2(incoming())
        && incoming().uid == existing().uid
        && incoming().fecha == existing().fecha
        && incoming().mensaje == existing().mensaje
        && incoming().usuario == existing().usuario
        && incoming().diff(existing()).affectedKeys().hasOnly(['leido'])
        && incoming().leido is bool;
      allow delete: if isAdmin() && isValidId(sugerenciaId);
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserDoc(incoming())
        && incoming().keys().hasOnly(['activeSessionId', 'lastLoginAt'])
        && incoming().lastLoginAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserDoc(incoming())
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['activeSessionId', 'lastLoginAt'])
            && incoming().lastLoginAt == request.time
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['vipTipo', 'vipActivo', 'vipCodigo', 'vipExpiraAt', 'vipActivadoAt'])
            && !('vipTipo' in existing() && existing().vipTipo == 'fundador' && 'vipActivo' in existing() && existing().vipActivo == true)
            && 'vipTipo' in incoming()
            && 'vipActivo' in incoming()
            && 'vipCodigo' in incoming()
            && 'vipActivadoAt' in incoming()
            && incoming().vipActivo == true
            && incoming().vipActivadoAt == request.time
            && exists(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo))
            && get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.activo == true
            && get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.usosActuales < get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.maxUsos
            && get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.tipoVip == incoming().vipTipo
            && (
              (incoming().vipTipo == 'fundador' && incoming().vipExpiraAt == null) ||
              (
                (incoming().vipTipo == 'estandar' || incoming().vipTipo == 'rastreo_cepos' || incoming().vipTipo == 'vip_m34')
                && get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.expiraAt is timestamp
                && get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.expiraAt > request.time
                && incoming().vipExpiraAt == get(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)).data.expiraAt
              )
            )
            && !exists(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)/canjes/$(userId))
            && existsAfter(/databases/$(database)/documents/codigos_vip/$(incoming().vipCodigo)/canjes/$(userId))
          )
        );
      allow delete: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());

      match /hojaVida/{docId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'principal'
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidHojaVida(incoming())
          && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'principal'
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidHojaVida(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'tipoVehiculo', 'placa', 'kmActual',
            'soatVencimiento', 'tecnoVencimiento',
            'paseVencimiento', 'tarjetaOperacionVencimiento', 'pazSalvoVencimiento',
            'recordatorios', 'updatedAt'
          ])
          && incoming().updatedAt == request.time;

        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && request.auth.uid == userId;
      }
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && isValidId(adminId)
        && incoming().keys().hasAll(['email', 'role'])
        && incoming().keys().hasOnly(['email', 'role'])
        && incoming().email is string && incoming().email.size() <= 200
        && incoming().role == 'admin';
    }

    match /puntos_reaccion/{puntoId} {
      // Reaction zones contain zero PII and are bounded to <= 100 docs so clients can auto-promote alerts inside active zones
      allow get: if isValidId(puntoId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isAdmin()
        && isValidId(puntoId)
        && isValidPuntoReaccion(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(puntoId)
        && isValidPuntoReaccion(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'lat', 'lng', 'radioMetros']);
      allow delete: if isAdmin() && isValidId(puntoId);
    }

    match /puntos_reaccion_inmediata/{puntoId} {
      // Immediate reaction zones contain zero PII and are bounded to <= 100 docs so clients can auto-promote alerts inside active zones
      allow get: if isValidId(puntoId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isAdmin()
        && isValidId(puntoId)
        && isValidPuntoReaccion(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(puntoId)
        && isValidPuntoReaccion(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'lat', 'lng', 'radioMetros']);
      allow delete: if isAdmin() && isValidId(puntoId);
    }

    match /codigos_vip/{codeId} {
      // Zero-PII code lookup by exact code ID only; listing is strictly restricted to General Admins
      allow get: if isSignedIn() && isValidId(codeId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(codeId)
        && isValidCodigoVip(incoming())
        && incoming().codigo == codeId
        && incoming().usosActuales == 0
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(codeId)
        && isValidCodigoVip(incoming())
        && incoming().codigo == existing().codigo
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['activo', 'maxUsos', 'expiraAt', 'tipoVip', 'nota'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['usosActuales'])
            && existing().activo == true
            && existing().usosActuales < existing().maxUsos
            && incoming().usosActuales == existing().usosActuales + 1
            && (
              (existing().tipoVip == 'fundador' && existing().expiraAt == null) ||
              (existing().expiraAt is timestamp && existing().expiraAt > request.time)
            )
            && !exists(/databases/$(database)/documents/codigos_vip/$(codeId)/canjes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/codigos_vip/$(codeId)/canjes/$(request.auth.uid))
          )
        );
      allow delete: if isAdmin() && isValidId(codeId);

      match /canjes/{userId} {
        allow get: if isSignedIn()
          && isValidId(codeId)
          && isValidId(userId)
          && (request.auth.uid == userId || isAdmin());
        allow list: if isAdmin();
        allow create: if isSignedIn()
          && isValidId(codeId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/codigos_vip/$(codeId))
          && !exists(/databases/$(database)/documents/codigos_vip/$(codeId)/canjes/$(userId))
          && isValidCanjeVip(incoming())
          && incoming().uid == request.auth.uid
          && incoming().codigo == codeId
          && incoming().tipoVip == get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.tipoVip
          && incoming().canjeadoAt == request.time
          && get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.activo == true
          && get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.usosActuales < get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.maxUsos
          && (
            (get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.tipoVip == 'fundador' && get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.expiraAt == null) ||
            (get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.expiraAt is timestamp && get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.expiraAt > request.time)
          )
          && getAfter(/databases/$(database)/documents/codigos_vip/$(codeId)).data.usosActuales == get(/databases/$(database)/documents/codigos_vip/$(codeId)).data.usosActuales + 1;
        allow update: if false;
        allow delete: if isAdmin() && isValidId(codeId) && isValidId(userId);
      }
    }

    match /cierres_evento/{eventoId} {
      // Zero-PII public road closure & evacuation geometry for drivers; creation, tracing, schedule & deletion strictly restricted to Admins
      allow get: if isValidId(eventoId);
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create: if isAdmin()
        && isValidId(eventoId)
        && isValidCierreEvento(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(eventoId)
        && isValidCierreEvento(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'titulo', 'sector', 'mensaje', 'cierreModo', 'cierrePuntos',
          'evacuacionRutas', 'centerLat', 'centerLng', 'startsAtMs', 'endsAtMs',
          'activo', 'sinSonar', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(eventoId);
    }

    match /emergencias_m34/{eventoId} {
      // Guild emergency beacons restricted strictly to active VIP M34 users and verified Admins (zero PII: apodo only)
      allow get: if isVipM34OrAdmin() && isValidId(eventoId);
      allow list: if isVipM34OrAdmin() && request.query.limit != null && request.query.limit <= 50;

      allow create: if isVipM34OrAdmin()
        && isValidId(eventoId)
        && isValidEmergenciaM34(incoming())
        && incoming().estado == 'ACTIVA'
        && incoming().authorId == request.auth.uid
        && incoming().fotoCierre == null
        && incoming().finalizadoPorUid == null
        && incoming().finalizadoPorApodo == null
        && incoming().finalizadoAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVipM34OrAdmin()
        && isValidId(eventoId)
        && isValidEmergenciaM34(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().estado == 'ACTIVA'
        && (
          (
            existing().authorId == request.auth.uid
            && incoming().estado == 'ACTIVA'
            && incoming().diff(existing()).affectedKeys().hasOnly(['lat', 'lng', 'sector', 'updatedAt'])
          ) ||
          (
            incoming().estado == 'FINALIZADA'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'estado', 'fotoCierre', 'finalizadoPorUid', 'finalizadoPorApodo', 'finalizadoAt', 'updatedAt'
            ])
            && incoming().finalizadoPorUid == request.auth.uid
            && incoming().finalizadoPorApodo is string
            && incoming().finalizadoPorApodo.size() >= 1
            && incoming().finalizadoAt == request.time
            && (
              existing().authorId == request.auth.uid ||
              exists(/databases/$(database)/documents/emergencias_m34/$(eventoId)/apoyos/$(request.auth.uid)) ||
              existsAfter(/databases/$(database)/documents/emergencias_m34/$(eventoId)/apoyos/$(request.auth.uid)) ||
              isAdmin()
            )
          )
        );

      allow delete: if isAdmin() && isValidId(eventoId);

      match /apoyos/{userId} {
        allow get: if isVipM34OrAdmin() && isValidId(eventoId) && isValidId(userId);
        allow list: if isVipM34OrAdmin() && request.query.limit != null && request.query.limit <= 100;

        allow create: if isVipM34OrAdmin()
          && isValidId(eventoId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/emergencias_m34/$(eventoId))
          && get(/databases/$(database)/documents/emergencias_m34/$(eventoId)).data.estado == 'ACTIVA'
          && isValidApoyoM34(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVipM34OrAdmin()
          && isValidId(eventoId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/emergencias_m34/$(eventoId))
          && get(/databases/$(database)/documents/emergencias_m34/$(eventoId)).data.estado == 'ACTIVA'
          && isValidApoyoM34(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'apodo', 'tipoVehiculo', 'lat', 'lng', 'sector', 'estadoApoyo', 'updatedAt'
          ]);

        allow delete: if isVipM34OrAdmin()
          && isValidId(eventoId)
          && isValidId(userId)
          && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
