rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'faoj2013@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidReporte(data) {
      return data.keys().hasAll([
          'lat', 'lng', 'tipo', 'descripcion', 'isFixed',
          'timestamp', 'confirmations', 'denials', 'authorId'
        ])
        && data.keys().hasOnly([
          'lat', 'lng', 'tipo', 'descripcion', 'isFixed',
          'timestamp', 'urlFoto', 'mediaType', 'confirmations', 'denials', 'authorId'
        ])
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.tipo is string && data.tipo.size() >= 2 && data.tipo.size() <= 40
        && data.descripcion is string && data.descripcion.size() <= 400
        && data.isFixed is bool
        && data.timestamp is timestamp
        && data.confirmations is int && data.confirmations >= 0
        && data.denials is int && data.denials >= 0
        && data.authorId is string && isValidId(data.authorId)
        && (!('urlFoto' in data) || data.urlFoto == null || (data.urlFoto is string && data.urlFoto.size() <= 450000))
        && (!('mediaType' in data) || data.mediaType == null || data.mediaType == 'image' || data.mediaType == 'video');
    }

    function isValidVoto(data) {
      return data.keys().hasAll(['voteType', 'userId', 'createdAt'])
        && data.keys().hasOnly(['voteType', 'userId', 'createdAt'])
        && (data.voteType == 'confirm' || data.voteType == 'deny')
        && data.userId is string && isValidId(data.userId)
        && data.createdAt is timestamp;
    }

    function isValidSugerencia(data) {
      return data.keys().hasAll(['mensaje', 'usuario', 'authorId', 'timestamp'])
        && data.keys().hasOnly(['mensaje', 'usuario', 'authorId', 'timestamp'])
        && data.mensaje is string && data.mensaje.size() >= 3 && data.mensaje.size() <= 1000
        && data.usuario is string && data.usuario.size() >= 3 && data.usuario.size() <= 200
        && data.authorId is string && isValidId(data.authorId)
        && data.timestamp is timestamp;
    }

    match /reportes/{reportId} {
      // Road alerts contain zero PII and are public for drivers viewing the map (bounded to <= 200 docs per query)
      allow get: if isValidId(reportId);
      allow list: if request.query.limit != null && request.query.limit <= 200;

      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReporte(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().timestamp == request.time
        && incoming().confirmations == 1
        && incoming().denials == 0
        && (incoming().isFixed == false || isAdmin());

      allow update: if isSignedIn()
        && isValidId(reportId)
        && isValidReporte(incoming())
        && incoming().authorId == existing().authorId
        && incoming().timestamp == existing().timestamp
        && incoming().lat == existing().lat
        && incoming().lng == existing().lng
        && (
          (
            isAdmin()
            && !incoming().diff(existing()).affectedKeys().hasAny(['confirmations', 'denials'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['confirmations'])
            && incoming().confirmations == existing().confirmations + 1
            && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['denials'])
            && incoming().denials == existing().denials + 1
            && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/reportes/$(reportId)/votos/$(request.auth.uid))
          ) ||
          (
            existing().authorId == request.auth.uid
            && incoming().isFixed == existing().isFixed
            && incoming().diff(existing()).affectedKeys().hasOnly(['tipo', 'descripcion', 'urlFoto', 'mediaType'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(reportId)
        && (existing().authorId == request.auth.uid || isAdmin());

      match /votos/{userId} {
        allow get: if isSignedIn()
          && isValidId(reportId)
          && isValidId(userId)
          && request.auth.uid == userId;

        allow list, update, delete: if false;

        allow create: if isSignedIn()
          && isValidId(reportId)
          && isValidId(userId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/reportes/$(reportId))
          && !exists(/databases/$(database)/documents/reportes/$(reportId)/votos/$(userId))
          && isValidVoto(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
      }
    }

    match /buzon/{sugerenciaId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(sugerenciaId)
        && isValidSugerencia(incoming())
        && incoming().timestamp == request.time
        && (
          (request.auth == null && incoming().authorId == 'anonimo' && incoming().usuario == 'Anónimo') ||
          (isSignedIn() && incoming().authorId == request.auth.uid)
        );
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && isValidId(adminId)
        && incoming().keys().hasAll(['email', 'role'])
        && incoming().keys().hasOnly(['email', 'role'])
        && incoming().email is string && incoming().email.size() <= 200
        && incoming().role == 'admin';
    }
  }
}
